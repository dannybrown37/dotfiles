#!/usr/bin/env bash

set -euo pipefail

# prek can't own .git/hooks here (core.hooksPath points at this dir
# instead), so forward to it manually rather than running `prek install`.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if ! command -v prek &>/dev/null || [[ ! -f "${repo_root}/.pre-commit-config.yaml" ]]; then
    exit 0
fi

exec prek run --hook-stage pre-commit
