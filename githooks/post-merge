#!/usr/bin/env bash

set -euo pipefail

store="${PASSWORD_STORE_DIR:-${HOME}/.password-store}"

if [[ -d "${store}/.git" ]]; then
    if ! git -C "${store}" pull --ff-only 2>&1 | sed 's/^/[password-store] /'; then
        echo "[password-store] pull failed -- not blocking dotfiles pull" >&2
    fi
fi

exit 0
