.shell pwsh

# whkd config for komorebi window management (Windows, loaded by `komorebic start --whkd --bar`)
# Modifier scheme: alt + vim-style hjkl (h=left, j=down, k=up, l=right)
# First draft -- exact komorebic subcommand names/flags haven't been run against
# the installed komorebic version yet, verify each binding on Windows.

# focus
alt + h         : komorebic focus left
alt + j         : komorebic focus down
alt + k         : komorebic focus up
alt + l         : komorebic focus right

# move window
alt + shift + h : komorebic move left
alt + shift + j : komorebic move down
alt + shift + k : komorebic move up
alt + shift + l : komorebic move right

# resize
alt + ctrl + h  : komorebic resize-axis horizontal decrease
alt + ctrl + l  : komorebic resize-axis horizontal increase
alt + ctrl + j  : komorebic resize-axis vertical decrease
alt + ctrl + k  : komorebic resize-axis vertical increase

# workspaces: 1 Main, 2 Email, 3 Terminal, 4 Spotify, 5 Learning
alt + 1         : komorebic focus-workspace 0
alt + 2         : komorebic focus-workspace 1
alt + 3         : komorebic focus-workspace 2
alt + 4         : komorebic focus-workspace 3
alt + 5         : komorebic focus-workspace 4

alt + shift + 1 : komorebic move-to-workspace 0
alt + shift + 2 : komorebic move-to-workspace 1
alt + shift + 3 : komorebic move-to-workspace 2
alt + shift + 4 : komorebic move-to-workspace 3
alt + shift + 5 : komorebic move-to-workspace 4

# window/layout state
alt + f         : komorebic toggle-float
alt + shift + f : komorebic toggle-monocle
alt + shift + t : komorebic toggle-tiling
alt + r         : komorebic retile
alt + m         : komorebic minimize

# stack cycling
alt + oem_4     : komorebic cycle-stack previous
alt + oem_6     : komorebic cycle-stack next

# jump straight to the pinned spotify_player tmux window, from anywhere
alt + s         : komorebic focus-workspace 0 ; wsl.exe bash -l -i -c "source ~/.bashrc; spotify_player_jump"

# reload komorebi.json after editing
alt + shift + r : komorebic reload-configuration
