{
  "permissions": {
    "allow": [
      "Bash(skill-tree repo-audit .)",
      "Bash(git check-ignore *)",
      "Bash(wslpath -w *)",
      "Bash(zizmor .)",
      "Bash(zizmor .github/workflows/)",
      "Bash(glow -s dark -w 80 docs/*)",
      "Bash(glow --version)",
      "Bash(gh extension list)",
      "Bash(just --list)",
      "Bash(just --list --unsorted)",
      "Bash(just --version)",
      "Bash(actionlint)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check_secret_exposure.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/verify_changes.py",
            "timeout": 330,
            "statusMessage": "Verifying changed files with prek..."
          }
        ]
      }
    ]
  }
}
