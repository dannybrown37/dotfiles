{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "h=\"${FLEET_HOOK:-${DOTFILES_DIR:-$HOME/projects/dotfiles}/scripts/fleet-hook.sh}\"; [ -x \"$h\" ] || exit 0; exec \"$h\" copilot sessionStart",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "h=\"${FLEET_HOOK:-${DOTFILES_DIR:-$HOME/projects/dotfiles}/scripts/fleet-hook.sh}\"; [ -x \"$h\" ] || exit 0; exec \"$h\" copilot userPromptSubmitted",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "h=\"${FLEET_HOOK:-${DOTFILES_DIR:-$HOME/projects/dotfiles}/scripts/fleet-hook.sh}\"; [ -x \"$h\" ] || exit 0; exec \"$h\" copilot postToolUse",
        "timeoutSec": 5
      }
    ],
    "permissionRequest": [
      {
        "type": "command",
        "bash": "h=\"${FLEET_HOOK:-${DOTFILES_DIR:-$HOME/projects/dotfiles}/scripts/fleet-hook.sh}\"; [ -x \"$h\" ] || exit 0; exec \"$h\" copilot permissionRequest",
        "timeoutSec": 5
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": "h=\"${FLEET_HOOK:-${DOTFILES_DIR:-$HOME/projects/dotfiles}/scripts/fleet-hook.sh}\"; [ -x \"$h\" ] || exit 0; exec \"$h\" copilot notification",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "h=\"${FLEET_HOOK:-${DOTFILES_DIR:-$HOME/projects/dotfiles}/scripts/fleet-hook.sh}\"; [ -x \"$h\" ] || exit 0; exec \"$h\" copilot agentStop",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "h=\"${FLEET_HOOK:-${DOTFILES_DIR:-$HOME/projects/dotfiles}/scripts/fleet-hook.sh}\"; [ -x \"$h\" ] || exit 0; exec \"$h\" copilot errorOccurred",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "h=\"${FLEET_HOOK:-${DOTFILES_DIR:-$HOME/projects/dotfiles}/scripts/fleet-hook.sh}\"; [ -x \"$h\" ] || exit 0; exec \"$h\" copilot sessionEnd",
        "timeoutSec": 5
      }
    ]
  }
}
