[user]
	name = Danny Brown
    # No email here on purpose. Identity comes from the includeIf blocks at the
    # bottom, matched on the remote. useConfigOnly makes git refuse to guess an
    # address from the hostname, so an unmatched repo fails instead of quietly
    # committing as the wrong account.
    useConfigOnly = true
	email = dannybrown37@gmail.com
[branch]
    sort = -committerdate
[core]
    editor = nvim
    pager = delta
    excludesfile = ~/.gitignore_global
[init]
    defaultBranch = main
[pull]
    ff = only
    rebase = true
[push]
    default = current
    autoSetupRemote = true
[fetch]
    prune = true
[rebase]
    autostash = true
[rerere]
    enabled = true
    autoupdate = true
[commit]
    verbose = true
[log]
    abbrevCommit = true
    date = relative
[merge]
    conflictStyle = diff3
    tool = nvimdiff
[mergetool]
    keepBackup = false
# @doc git-alias: gmt -> git mergetool
# @doc git-alias: start <topic> -> fresh branch off updated main, carrying uncommitted changes
# @doc git-alias: ship -> push, open PR titled "<top commit prefix>: <branch>", auto-merge on green, wait for CI to start, watch checks
# @doc git-alias: done -> back to updated main after merge
[alias]
    gmt = mergetool
    start = "!f() { [ -n \"$1\" ] || { echo 'usage: git start <topic>' >&2; return 2; }; from=$(git branch --show-current); stashed=0; if [ -n \"$(git status --porcelain)\" ]; then git stash push -u -m \"git start $1\" || return 1; stashed=1; fi; if ! { git switch main && git pull --ff-only && git switch -c \"$1\"; }; then [ \"$stashed\" = 0 ] || { git switch \"$from\" >/dev/null 2>&1; git stash pop; }; return 1; fi; [ \"$stashed\" = 0 ] || git stash pop || { echo 'carried changes conflict: fix the files, git add them, then git stash drop' >&2; return 1; }; }; f"
    ship = "!f() { b=$(git branch --show-current); [ \"$b\" != main ] || { echo 'on main: run git start <topic> first' >&2; return 2; }; p=$(git log --format=%s origin/main..HEAD | awk 'BEGIN { n = split(\"chore style test docs ci build revert refactor perf fix feat\", o, \" \"); for (i = 1; i <= n; i++) rank[o[i]] = i } match($0, /^[a-z]+(\\([^)]*\\))?!?:/) { k = $0; sub(/[(!:].*/, \"\", k); if (rank[k] > top) { top = rank[k]; p = k } if (substr($0, RLENGTH - 1, 1) == \"!\") bang = \"!\" } END { if (p) print p bang }'); [ -n \"$p\" ] || { echo 'no conventional commit prefix in origin/main..HEAD' >&2; return 2; }; git push -u origin HEAD && gh pr create --title \"$p: $(echo \"$b\" | tr '_-' '  ')\" --body \"$(git log --reverse --format='- %s' origin/main..HEAD)\" && gh pr merge --auto --squash --delete-branch && { n=0; while gh pr checks 2>&1 >/dev/null | grep -q 'no checks reported'; do n=$((n + 1)); [ \"$n\" -lt 30 ] || { echo 'no CI checks after 60s: run gh pr checks --watch later' >&2; return 1; }; [ \"$n\" != 1 ] || echo 'waiting for CI to start...' >&2; sleep \"${GIT_SHIP_POLL_SECS:-2}\"; done; gh pr checks --watch; }; }; f"
    done = "!git switch main && git pull --ff-only"
[column]
    ui = auto
[help]
    autocorrect = prompt
[diff]
    colorMoved = default
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential

# Identity and credentials follow the remote, not the directory -- a repo
# cloned somewhere unexpected still gets the right account. Anything matching
# nothing here has no email and refuses to commit (see user.useConfigOnly).
[includeIf "hasconfig:remote.*.url:https://github.com/dannybrown37/**"]
    path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:dannybrown37/**"]
    path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/dannybrown37/**"]
    path = ~/.gitconfig-personal

# The password store has a personal remote, so it is covered above. This keeps
# it working even before a remote is configured on a fresh machine.
[includeIf "gitdir:~/.password-store/"]
    path = ~/.gitconfig-personal

# Any non-personal identity is defined outside this repo -- see the private
# include below. Missing file is ignored, so machines without one just inherit
# the fail-loud default.
[include]
    path = ~/.gitconfig-private
